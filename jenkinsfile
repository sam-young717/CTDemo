pipeline {
    agent any
    stages {
        stage('Publishing Static Analysis Results') {
            steps {
                recordIssues (
                    tools: [
                        parasoftFindings (
                            pattern: '**/report.xml',
                            localSettingsPath: 'settings.properties'
                        )
                    ]
                )
            }
        }

        stage('Publishing Code Coverage Results') {
            steps {
                recordParasoftCoverage (
                    pattern: '**/coverage.xml',
                    referenceBuild: '20',
                    referenceJob: 'CT',
                    sourceCodeEncoding: 'UTF-8'
                )
            }
    }
}